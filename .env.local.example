# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# LiveKit WebRTC server WebSocket URL (same as backend LIVEKIT_URL)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Centrifugo WebSocket (optional — persistent dashboard chat)
NEXT_PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket

# Supabase (optional — required for Google OAuth on the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
